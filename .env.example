# =============================================================================
# RODAKU — Template environment
# Cara pakai: salin file ini menjadi `.env` lalu isi nilai sesungguhnya.
#   cp .env.example .env
# `/.env` sudah masuk .gitignore — JANGAN pernah commit isi `.env` yang asli.
# Semua variabel database di bawah WAJIB diisi agar app bisa jalan.
# =============================================================================

# --- Server (server.ts) -------------------------------------------------------
# Mode runtime. Biasanya di-set otomatis oleh `next`/`tsx` (development | production).
# Biarkan dikomentari kecuali Anda tahu apa yang dilakukan.
# NODE_ENV=development

# Port HTTP custom server + Socket.io. Default: 3000
PORT=3000

# Host/alamat yang di-bind & ditampilkan saat server start. Default: localhost
# Untuk akses dari luar mesin (HP driver/pelanggan di jaringan yang sama) pakai
# 0.0.0.0 atau IP LAN, dan pastikan firewall mengizinkan port ini.
HOSTNAME=localhost

# --- Database PostgreSQL / Supabase (src/lib/db.ts, prisma.config.ts) ---------
# Ambil URL dari Supabase Dashboard > Project Settings > Database.
#
# DATABASE_URL = koneksi POOLER (port 6543, pgbouncer=true).
#   Dipakai app saat runtime (serverless-friendly, hemat koneksi).
# DIRECT_URL = koneksi LANGSUNG (port 5432, tanpa pgbouncer).
#   Hanya dipakai Prisma CLI untuk `db push` / migrasi (DDL gagal lewat pooler).
#
# Ganti <PASSWORD> dengan password database Supabase Anda (URL-encode karakter
# khusus, mis. ' -> %27).
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth / URL publik --------------------------------------------------------
# URL dasar aplikasi (dipakai NextAuth & link absolut). Di Vercel isi domain produksi.
NEXTAUTH_URL="https://rodaku.my.id"
NEXT_PUBLIC_APP_URL="https://rodaku.my.id"

# --- Login Google / Google Identity Services (src/components/AuthPanel.tsx) ----
# OAuth Client ID dari Google Cloud Console. NEXT_PUBLIC_* = ter-ekspor ke browser.
# Isi dengan Client ID Anda; kosongkan (hapus barisnya) untuk memakai login
# email/password saja (tombol Google otomatis disembunyikan).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcd1234.apps.googleusercontent.com

# --- Keamanan webhook pembayaran QRIS (src/lib/financeSecurity.ts) ------------
# Secret bersama untuk verifikasi HMAC-SHA256 header `x-callback-signature`
# dari acquirer/payment gateway. Kosong = MODE SANDBOX (webhook tanpa signature
# diterima — HANYA untuk localhost). WAJIB diisi di produksi.
# Contoh nilai dummy:
QRIS_WEBHOOK_SECRET=ganti-dengan-secret-acquirer-minimal-32-karakter

# --- Next.js (next.config.ts) -------------------------------------------------
# Folder output build Next.js. Default: .next
# Hanya dipakai oleh suite verifikasi (tests/) untuk instance Next kedua.
NEXT_DIST_DIR=.next

# --- Testing / suite verifikasi (tests/harness.ts) ----------------------------
# Port server verifikasi. Default: 3199
VERIFY_PORT=3199
# Isi apa saja (mis. 1) untuk mencetak log server verifikasi ke stdout.
VERIFY_DEBUG=
