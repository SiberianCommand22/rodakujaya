generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum VehicleType {
  RODA_MOTOR
  RODA_MOBIL
}

enum OrderStatus {
  SEARCHING
  ACCEPTED
  PICKING_UP
  ON_TRIP
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CLAIMED
  PAID
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  role      Role     @default(CUSTOMER)
  phone     String?
  googleId  String?  @unique
  avatar    String?

  /// Nama bank rekening (mis. BCA, Mandiri, BRI, BNI).
  bankName String?
  /// Nomor rekening untuk menerima transfer P2P.
  accountNumber String?
  /// Nama pemilik rekening (sesuai buku tabungan).
  accountHolderName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver   Driver?
  orders   Order[]  @relation("CustomerOrders")
  sessions Session[]
  reviews  Review[]
}

model Driver {
  id            String      @id @default(cuid())
  userId        String      @unique
  vehicleType   VehicleType @default(RODA_MOTOR)
  plateNumber   String
  /// Merek / tipe kendaraan mitra (mis. Honda Beat / Toyota Avanza).
  vehicleBrand  String?
  isOnline      Boolean     @default(false)
  /// Ditangguhkan administrator: tidak bisa login / online.
  isBlocked     Boolean     @default(false)
  lastLat       Float?
  lastLng       Float?
  rating        Float       @default(5.0)
  /// Rolling average of customer reviews, recomputed on every new review.
  ratingAvg     Float       @default(5.0)
  /// Number of completed trips that produced a review.
  totalTrips    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders  Order[]  @relation("DriverOrders")
  reviews Review[]
}

model Order {
  id             String      @id @default(cuid())
  customerId     String
  driverId       String?
  vehicleType    VehicleType @default(RODA_MOTOR)
  status         OrderStatus @default(SEARCHING)

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String?
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String?

  distanceKm     Float
  fare           Int
  /// Kode promo yang dipakai pelanggan (mis. RODAHEMAT), null bila tanpa voucher.
  promoCode      String?
  /// Besaran potongan harga dalam rupiah yang sudah divalidasi server.
  discount       Int      @default(0)
  /// Catatan patokan opsional untuk driver (mis. "tunggu di lobi utara").
  driverNote     String?
  /// Alasan pembatalan yang dipilih pelanggan saat membatalkan pesanan.
  cancelReason   String?
  /// Estimated travel time from the routing engine (minutes).
  durationMin    Float?
  /// "OSRM" when a real road route was used, "FALLBACK" when estimated.
  routeSource    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer User     @relation("CustomerOrders", fields: [customerId], references: [id])
  driver   Driver?  @relation("DriverOrders", fields: [driverId], references: [id])

  payment Payment?
  review  Review?

  @@index([status])
  @@index([customerId])
}

/// One payment per order. Records the P2P bank transfer claim lifecycle:
/// PENDING (belum ada klaim) → CLAIMED (pelanggan menekan "Saya Sudah
/// Transfer") → PAID (driver mengonfirmasi dana masuk) atau FAILED.
model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique
  method    PaymentMethod
  amount    Decimal
  status    PaymentStatus @default(PENDING)
  /// Bank yang dituju pelanggan saat transfer (snapshot dari profil driver).
  bankName  String?
  /// Nomor rekening tujuan (snapshot dari profil driver).
  accountNumber String?
  /// Nama pemilik rekening tujuan (snapshot dari profil driver).
  accountHolderName String?
  paidAt    DateTime?
  claimedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// One review per order, so a trip cannot be rated twice.
model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  driverId   String
  rating     Int
  comment    String?
  /// Tag apresiasi yang dipilih pelanggan, disimpan sebagai JSON array.
  tags       String?
  createdAt  DateTime @default(now())

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([customerId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
